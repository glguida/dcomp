#!/bin/sh
set -eu

root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
temporary=$(mktemp -d)
name="smoke-$$"
state_root="$temporary/state"
runtime_root="$temporary/run"
second_state_root="$temporary/state-second"
second_runtime_root="$temporary/run-second"
system_file="$temporary/system.dcomp"
namespace=$(printf %s "$state_root" | sha256sum | cut -c1-32)
second_namespace=$(printf %s "$second_state_root" | sha256sum | cut -c1-32)
resource_prefix="dcomp.$namespace.$name"
second_resource_prefix="dcomp.$second_namespace.$name"
container_prefix="$resource_prefix.container"
second_container_prefix="$second_resource_prefix.container"
echo_network="$resource_prefix.component.echo"
uppercase_network="$resource_prefix.component.uppercase"
caller_network="$resource_prefix.component.caller"
old_link_network="$resource_prefix.link.uppercase.upstream"
attach_pid=

dcomp() {
    "$root/bin/dcomp" --state-root "$state_root" --runtime-root "$runtime_root" "$@"
}

dcomp_second() {
    "$root/bin/dcomp" --state-root "$second_state_root" \
        --runtime-root "$second_runtime_root" "$@"
}

cleanup() {
    if [ -n "$attach_pid" ]; then
        kill "$attach_pid" >/dev/null 2>&1 || true
        wait "$attach_pid" >/dev/null 2>&1 || true
    fi
    dcomp abort "$name" >/dev/null 2>&1 || true
    dcomp down "$name" >/dev/null 2>&1 || true
    dcomp_second abort "$name" >/dev/null 2>&1 || true
    dcomp_second down "$name" >/dev/null 2>&1 || true
    rm -rf "$temporary"
}
trap cleanup EXIT HUP INT TERM

mkdir -p "$temporary/echo" "$temporary/uppercase" "$temporary/caller"
cp "$root/examples/echo/component.dcomp" "$temporary/echo/component.dcomp"
cp "$root/examples/uppercase/component.dcomp" "$temporary/uppercase/component.dcomp"
cp "$root/examples/caller/component.dcomp" "$temporary/caller/component.dcomp"
{
    printf '%s\n' \
        "system $name" \
        "component echo echo" \
        "component uppercase uppercase" \
        "component caller caller" \
        "args caller --wait" \
        "publish uppercase tcp 127.0.0.1 0 8080" \
        "egress uppercase" \
        "link uppercase.upstream echo.echo" \
        "link caller.upstream uppercase.echo"
} >"$system_file"

dcomp check "$system_file"
dcomp up "$system_file"

attempt=0
while ! status=$(dcomp status --json "$name" 2>&1); do
    attempt=$((attempt + 1))
    if [ "$attempt" -ge 30 ]; then
        printf '%s\n' "$status" >&2
        echo "integration: system did not become healthy" >&2
        exit 1
    fi
    sleep 1
done
printf '%s\n' "$status"

proxy_pid=$(sed -n '1p' "$runtime_root/$name/proxy.pid")
[ -n "$proxy_pid" ] && kill -0 "$proxy_pid"
[ -S "$runtime_root/$name/proxy.sock" ]
[ -S "$runtime_root/$name/in/uppercase.upstream" ]
[ -S "$runtime_root/$name/in/caller.upstream" ]
[ -S "$runtime_root/$name/out/echo.echo" ]
[ -S "$runtime_root/$name/out/uppercase.echo" ]

for component in echo caller; do
    [ "$(docker container inspect "$container_prefix.$component" \
        --format '{{.HostConfig.NetworkMode}}')" = "none" ]
done
for network in "$echo_network" "$caller_network"; do
    if docker network inspect "$network" >/dev/null 2>&1; then
        echo "integration: component without egress received network $network" >&2
        exit 1
    fi
done
[ "$(docker network inspect "$uppercase_network" --format '{{.Internal}}')" = "false" ]
[ "$(docker network inspect "$uppercase_network" --format '{{len .Containers}}')" = "1" ]
[ "$(docker container inspect "$container_prefix.uppercase" \
    --format '{{len .NetworkSettings.Networks}}')" = "1" ]
if docker network inspect "$old_link_network" >/dev/null 2>&1; then
    echo "integration: obsolete per-link network exists" >&2
    exit 1
fi

admin_port=$(docker container inspect "$container_prefix.uppercase" \
    --format '{{(index (index .NetworkSettings.Ports "8080/tcp") 0).HostPort}}')
case "$admin_port" in
    ''|*[!0-9]*)
        echo "integration: invalid dynamic admin port $admin_port" >&2
        exit 1
        ;;
esac
attempt=0
while ! admin_health=$(curl -fsS "http://127.0.0.1:$admin_port/healthz"); do
    attempt=$((attempt + 1))
    if [ "$attempt" -ge 30 ]; then
        echo "integration: published admin endpoint did not become ready" >&2
        exit 1
    fi
    sleep 1
done
[ "$admin_health" = "ok" ]

caller_socket="$runtime_root/$name/in/caller.upstream"
call_system() {
    docker run --rm --network none \
        --mount "type=bind,src=$caller_socket,dst=/run/dcomp/in/upstream" \
        -e DCOMP_IN_UPSTREAM=unix:///run/dcomp/in/upstream \
        dcomp-example-caller:dev "$1"
}

reply=$(call_system "hello components")
[ "$reply" = "HELLO COMPONENTS" ]
metrics=$(curl -fsS "http://127.0.0.1:$admin_port/metrics")
printf '%s\n' "$metrics" |
    grep '^dcomp_example_uppercase_requests_total 1$' >/dev/null

for component in echo uppercase caller; do
    environment=$(docker container inspect "$container_prefix.$component" \
        --format '{{range .Config.Env}}{{println .}}{{end}}')
    if printf '%s\n' "$environment" | grep '^DCOMP_LINK_' >/dev/null; then
        echo "integration: $component received removed DCOMP_LINK contract" >&2
        exit 1
    fi
done

interface_mounts() {
    docker container inspect "$container_prefix.$1" \
        --format '{{range .Mounts}}{{println .Destination}}{{end}}' |
        awk '/^\/run\/dcomp\// { print }' |
        sort
}
[ "$(interface_mounts echo)" = "/run/dcomp/out/echo" ]
[ "$(interface_mounts caller)" = "/run/dcomp/in/upstream" ]
uppercase_mounts=$(interface_mounts uppercase)
[ "$uppercase_mounts" = "$(printf '%s\n' /run/dcomp/in/upstream /run/dcomp/out/echo)" ]

attach_ready="$temporary/attach.ready"
attach_stdout="$temporary/attach.stdout"
attach_stderr="$temporary/attach.stderr"
: >"$attach_ready"
"$root/bin/dcomp" --state-root "$state_root" --runtime-root "$runtime_root" \
    attach --ready-fd 3 "$name" echo </dev/null >"$attach_stdout" 2>"$attach_stderr" \
    3>"$attach_ready" &
attach_pid=$!
attempt=0
while [ ! -s "$attach_ready" ]; do
    if ! kill -0 "$attach_pid" 2>/dev/null; then
        wait "$attach_pid" || true
        cat "$attach_stderr" >&2
        echo "integration: component attachment ended before ready" >&2
        exit 1
    fi
    attempt=$((attempt + 1))
    if [ "$attempt" -ge 30 ]; then
        echo "integration: component attachment did not become ready" >&2
        exit 1
    fi
    sleep 1
done
reply=$(call_system "attached output")
[ "$reply" = "ATTACHED OUTPUT" ]
attempt=0
while ! grep -F 'rpc=/dcomp.example.v1.Echo/Echo status=ok' "$attach_stderr" >/dev/null; do
    attempt=$((attempt + 1))
    if [ "$attempt" -ge 30 ]; then
        cat "$attach_stderr" >&2
        echo "integration: attached stderr omitted live component output" >&2
        exit 1
    fi
    sleep 1
done
kill "$attach_pid"
wait "$attach_pid" >/dev/null 2>&1 || true
attach_pid=

logs=$(dcomp logs "$name")
printf '%s\n' "$logs" |
    awk -F '\t' '$2 == "@proxy" && $4 ~ /connection paired/ { found = 1 } END { exit !found }'
printf '%s\n' "$logs" |
    awk -F '\t' '$2 == "echo" && $4 ~ /rpc=\/dcomp.example.v1.Echo\/Echo/ { found = 1 } END { exit !found }'

echo_id=$(docker container inspect "$container_prefix.echo" --format '{{.ID}}')
uppercase_id=$(docker container inspect "$container_prefix.uppercase" --format '{{.ID}}')
dcomp restart "$name" uppercase
[ "$(docker container inspect "$container_prefix.echo" --format '{{.ID}}')" = "$echo_id" ]
[ "$(docker container inspect "$container_prefix.uppercase" --format '{{.ID}}')" = "$uppercase_id" ]
[ "$(sed -n '1p' "$runtime_root/$name/proxy.pid")" = "$proxy_pid" ]

attempt=0
while ! dcomp status --json "$name" >/dev/null 2>&1; do
    attempt=$((attempt + 1))
    if [ "$attempt" -ge 30 ]; then
        echo "integration: restarted component did not become healthy" >&2
        exit 1
    fi
    sleep 1
done
reply=$(call_system "after restart")
[ "$reply" = "AFTER RESTART" ]

dcomp_second up "$system_file"
attempt=0
while ! dcomp_second status --json "$name" >/dev/null 2>&1; do
    attempt=$((attempt + 1))
    if [ "$attempt" -ge 30 ]; then
        echo "integration: second state-root system did not become healthy" >&2
        exit 1
    fi
    sleep 1
done
for component in echo uppercase caller; do
    docker container inspect "$container_prefix.$component" >/dev/null
    docker container inspect "$second_container_prefix.$component" >/dev/null
done
[ "$container_prefix" != "$second_container_prefix" ]
second_uppercase_network="$second_resource_prefix.component.uppercase"
docker network inspect "$uppercase_network" >/dev/null
docker network inspect "$second_uppercase_network" >/dev/null

dcomp down "$name"
for network in "$echo_network" "$uppercase_network" "$caller_network"; do
    if docker network inspect "$network" >/dev/null 2>&1; then
        echo "integration: network $network still exists after down" >&2
        exit 1
    fi
done
if docker container inspect "$container_prefix.echo" >/dev/null 2>&1; then
    echo "integration: component still exists after down" >&2
    exit 1
fi
if kill -0 "$proxy_pid" >/dev/null 2>&1; then
    echo "integration: proxy still runs after down" >&2
    exit 1
fi
[ ! -e "$runtime_root/$name" ]

dcomp_second status --json "$name" >/dev/null
for component in echo uppercase caller; do
    docker container inspect "$second_container_prefix.$component" >/dev/null
done
docker network inspect "$second_uppercase_network" >/dev/null
dcomp_second down "$name"
if docker container inspect "$second_container_prefix.echo" >/dev/null 2>&1; then
    echo "integration: second state-root component still exists after down" >&2
    exit 1
fi
if docker network inspect "$second_uppercase_network" >/dev/null 2>&1; then
    echo "integration: second state-root network still exists after down" >&2
    exit 1
fi
[ ! -e "$second_runtime_root/$name" ]

trap - EXIT HUP INT TERM
rm -rf "$temporary"
echo "dcomp integration: ok"
